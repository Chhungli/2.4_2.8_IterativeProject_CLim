/* this is my grid container which holds my website together */

.grid-container {
    display: grid;
    grid-template-rows: 50px 300px auto 150px;  /* Fix the order for: header, nav, content, footer */
	background-size: cover;
	background-repeat: none;
    height: 100vh;
}

/*navigation bar above the header */

.nav {
	box-sizing: border-box;
    background-color: #FA2626;
	grid-columns-start: 1;
	grid-columns-end: span 2;
}

/* this is my main header in the main content area */

.header {
    box-sizing: border-box;
    background-color: #373AF7;
    padding-top: 30px;
    font-size: 65px;
    text-align: center;
}

/* all unordered lists */

ul {
	display: inline;
	padding: 15px 0px 0px 0px;
	list-style: none;
}

ul li {
	font-family: Arial;
	font-size: 16px;
	font-weight: bold;
	display: inline-block;
	margin-right: 3px;
	position: relative;
	padding: 15px 50px 17px; /* padding for main block menu buttons */ 	 
}

ul li:hover {
	background:#FFF0C7;
}
	
nav ul {
	padding: 0;
	margin: 0;
	list-style-type: none;
	overflow: hidden;
	font-family: Arial;
	font-size: 16px;
	font-weight: bold;
}

/*hover colours*/
.nav a:link{color:black;} /* unvisited link */
.nav a:visited{color:black;} /* visited link */
.nav a:hover{color:black;} /* mouse over link */
.nav a:active{color:black;} /* selected link */

a {
	text-decoration: none;
}

ul li ul {
	padding: 0;
	position: absolute;
	top: 48px; /* space between each drop-down menu list */
	left: 0;
	width: 191px; /* width of drop-down menu list */
	display: none;
	visibility: hidden; /* this hides the drop-down menu list */
	z-index: 1; /* for overlapping divs, bringing to the front like a drop down menu */
}

ul li ul li { 
	background:#FFDD81; /* this is the drop-down menu background color */
	display: block;
}

ul li ul li:hover { background:#FFF0C7;} /* this is the drop-down menu hover on blocks */

ul li:hover ul {
	display: block;
	visibility: visible; /* this makes the drop-down menu visable*/
}

nav li {
	float: left;
	padding-left: 15px;
	padding-right: 15px;
	padding-bottom: 15px;
	padding-top: 15px;
}

/* style for navigation ends here*/

/* this is my CSS for my main content area (the middle box) */

.content {
    box-sizing: border-box;
    Background-color: white;
	/* set the color for the main content box */
}

.scroll-area {
    overflow: auto;
}

.footer {
    background-color: #FFE25F;
    font-size: 17px;
    color: black;
	padding-left: 15px;
	padding-top: 30px;
	text-align: center;
	margin-top: 15px;
}

/*css for image carousel*/

.slider {
	display: block;
	position: relative;
	width: 23%; /*adjustment to show each image on carosuel*/
	overflow: hidden; /*overflow hides next image*/
	margin: 15px;
	margin-left: auto;
	margin-right: auto;
}

.images {
	display: flex;
	width: 100%;
}

.images img {
	height: 400px;
	width: 100%;
	transition: all 0.15s ease; /*timing transition to show next image*/
}

.images input {
	display: none; /*hides the 3 images behind 1st image*/
}

.dots {
	display: flex;
	justify-content: center;
	margin: 5px;
}

.dots label {
	height: 20px;
	width: 20px;
	border-radius: 50%;
	border: solid black 3px;
	cursor: pointer;
	transition: all 0.15s ease;
	margin: 5px;
}

.dots label:hover {	background: darkblue;}
	#img1:checked ~ .m1 { /*selecor used to select "m" element following checked*/
	margin-left: 0;
}

#img2:checked ~ .m2 {
	margin-left: -100%;
}

#img3:checked ~ .m3 {
	margin-left: -200%;
}

#img4:checked ~ .m4 {
	margin-left: -300%;
}

.container {
	display: flex;
	border: 2px solid white;
}

.box {
   	flex: 1;
	margin: 15px;
	padding: 40px;
	padding-top: 30px;
	padding-left: 40px;
   	border: 2px solid #CBE8BA;
	width:  400px;
	height: 450px;
}

figure:has(figcaption) {
	max-width: 10%;
}


#textbox {
	border-style: none;
	width: 900px;
	height: auto;
	text-align: justify;
	background-color: #CBE8BA;
	word-wrap: break-word; /* words won't go from the boundry */
	margin: 30px 20px auto; /* top, left, bottom of the box*/
	padding: 20px 20px 30px; /* top, left, bottom of the text*/
	float: left;
	padding-left: 20px;
}

/* CSS for styling my Back to Top button */

#myBtn {
	position: fixed;
	bottom: 20px;
	right: 30px;
	z-index: 99;
	font-size: 18px;
	border: none;
	outline: none;
	background-color: var(--blue);
	color: black;
	cursor: white;
	padding: 15px;
	border-radius: 4px;
}

#myBtn:hover {
	background-color: var(--yellow);
}
