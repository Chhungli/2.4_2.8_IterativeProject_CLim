/* this is my grid container which holds my website together */

.grid-container {
    display: grid;
    grid-template-rows: 50px 300px auto 150px;  /* Fix the order for: header, nav, content, footer */
	background-size: cover;
	background-repeat: none;
    height: 100vh;
}

/*navigation bar above the header */

.nav {
	box-sizing: border-box;
    background-color: #FFDD81;
	grid-columns-start: 1;
	grid-columns-end: span 2;
}

/* this is my main header in the main content area */

.header {
    box-sizing: border-box;
    background-color: #033076;
	font-style: normal;
    font-weight: bold;
	color: #FFDD81;
    padding-top: 80px;
    font-size: 65px;
    text-align: center;
}

/* all unordered lists */

ul {
	display: inline;
	padding: 15px 0px 0px 0px;
	list-style: none;
}

ul li {
	font-family: Arial;
	font-size: 16px;
	font-weight: bold;
	display: inline-block;
	margin-right: 3px;
	position: relative;
	padding: 15px 50px 17px; /* padding for main block menu buttons */ 	 
}

ul li:hover {
	background:#FFF0C7;
}
	
nav ul {
	padding: 0;
	margin: 0;
	list-style-type: none;
	overflow: hidden;
	font-family: Arial;
	font-size: 16px;
	font-weight: bold;
}

/*hover colours*/
.nav a:link{color:black;} /* unvisited link */
.nav a:visited{color:black;} /* visited link */
.nav a:hover{color:black;} /* mouse over link */
.nav a:active{color:black;} /* selected link */

a {
	text-decoration: none;
}

ul li ul {
	padding: 0;
	position: absolute;
	top: 48px; /* space between each drop-down menu list */
	left: 0;
	width: 191px; /* width of drop-down menu list */
	display: none;
	visibility: hidden; /* this hides the drop-down menu list */
	z-index: 1; /* for overlapping divs, bringing to the front like a drop down menu */
}

ul li ul li { 
	background:#FFDD81; /* this is the drop-down menu background color */
	display: block;
}

ul li ul li:hover { background:#FFF0C7;} /* this is the drop-down menu hover on blocks */

ul li:hover ul {
	display: block;
	visibility: visible; /* this makes the drop-down menu visable*/
}

nav li {
	float: left;
	padding-left: 15px;
	padding-right: 15px;
	padding-bottom: 15px;
	padding-top: 15px;
}

/* style for navigation ends here*/

/* this is my CSS for my main content area (the middle box) */

.content {
    box-sizing: border-box;
    Background-color: white;
	/* set the color for the main content box */
}

.scroll-area {
    overflow: auto;
}

.footer {
    background-color: #033076;
    font-size: 17px;
    color: yellow;
	padding-left: 15px;
	padding-top: 50px;
	text-align: center;
	margin-top: 15px;
}

/*css for image carousel*/

.slider {
	display: block;
	position: relative;
	width: 23%; /*adjustment to show each image on carosuel*/
	overflow: hidden; /*overflow hides next image*/
	margin: 15px;
	margin-left: auto;
	margin-right: auto;
}

.images {
	display: flex;
	width: 100%;
}

.images img {
	height: 400px;
	width: 100%;
	transition: all 0.15s ease; /*timing transition to show next image*/
}

.images input {
	display: none; /*hides the 3 images behind 1st image*/
}

.dots {
	display: flex;
	justify-content: center;
	margin: 5px;
}

.dots label {
	height: 20px;
	width: 20px;
	border-radius: 50%;
	border: solid black 3px;
	cursor: pointer;
	transition: all 0.15s ease;
	margin: 5px;
}

.dots label:hover {	background: darkblue;}
	#img1:checked ~ .m1 { /*selecor used to select "m" element following checked*/
	margin-left: 0;
}

#img2:checked ~ .m2 {
	margin-left: -100%;
}

#img3:checked ~ .m3 {
	margin-left: -200%;
}

#img4:checked ~ .m4 {
	margin-left: -300%;
}

.container {
	display: flex;
	border: 2px solid white;
}

.box-container {
	display: flex;
	justify-content: center;
	gap: 30px;
	flex-wrap: wrap;
	margin-top: 40px; /* space above boxes */
	margin-bottom: 40px; /* space below boxes */
}

.box {
  display: block;
  margin: 0 auto 40px auto; /* centers it + adds bottom margin */
  padding: 40px 60px;
  border: 5px solid #033076;
  width: 610px;
  height: auto; /* let height adjust to content */
}

.camp-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px;
  font-family: Arial, sans-serif;
}

.camp-container h1 {
  text-align: center;
  margin-bottom: 30px;
  font-size: 36px;
}

.camp-days {
  display: flex;
  gap: 20px;
  margin-bottom: 30px;
}

.camp-box {
  flex: 1;
  border: 2px solid black;
  padding: 20px;
  background: #fff;
}

.camp-box h2 {
  text-align: center;
  margin-bottom: 15px;
}

.camp-reminders {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.camp-box.wide {
  width: 100%;
}

.camp-box ul {
  padding-left: 20px;
}

.camp-box li {
  margin-bottom: 10px;
}

figure:has(figcaption) {
	max-width: 10%;
}

.contact-grid {
  display: flex;
  justify-content: center;
  gap: 30px;
  margin: 50px auto;
  flex-wrap: nowrap; /* forces all 4 to stay in one row */
  max-width: 1400px;
}

.contact-box {
  flex: 1 1 250px; /* each box flexible but minimum 250px wide */
  border: 2px solid #033076;
  text-align: center;
  padding: 30px 20px;
  background: #fff;
  border-radius: 10px;
  box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  transition: transform 0.2s, box-shadow 0.2s;
}

.contact-box h3 {
  font-size: 20px;
  margin-bottom: 15px;
  color: #033076;
}

.contact-box p {
  margin: 8px 0;
  font-size: 15px;
  color: #000;
}

.contact-box i {
  display: block;
  margin: 20px auto 0;
  color: #033076;
}

.contact-box a {
  text-decoration: none;
  color: #033076;
  font-weight: bold;
}

.contact-box:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 16px rgba(0,0,0,0.15);
}

#textbox {
	border-style: none;
	width: 900px;
	height: auto;
	text-align: justify;
	background-color: #CBE8BA;
	word-wrap: break-word; /* words won't go from the boundry */
	margin: 30px 20px auto; /* top, left, bottom of the box*/
	padding: 20px 20px 30px; /* top, left, bottom of the text*/
	float: left;
	padding-left: 20px;
}

.photo-section {
  background-color: #033076; /* dark blue */
  padding: 40px 20px;
  text-align: center;
}

.photo-section h2 {
  color: white;
  font-size: 36px;
  margin-bottom: 30px;
}

.photo-gallery {
  display: flex;
  justify-content: center;
  gap: 40px;
  flex-wrap: wrap;
}

.photo-gallery img {
  width: 300px;
  height: auto;
  border-radius: 10px;
  box-shadow: 0 4px 8px rgba(0,0,0,0.4);
  transition: transform 0.3s;
}

.photo-gallery img:hover {
  transform: scale(1.05);
}

.iframe {
  display: block;
  margin: 50px auto; /* centres the video horizontally */
  width: 560px;
  max-width: 90%; /* makes it responsive for smaller screens */
  height: 315px;
}

/* CSS for styling my Back to Top button */

#myBtn {
	position: fixed;
	bottom: 20px;
	right: 30px;
	z-index: 99;
	font-size: 18px;
	border: none;
	outline: none;
	background-color: var(--blue);
	color: black;
	cursor: white;
	padding: 15px;
	border-radius: 4px;
}

#myBtn:hover {
	background-color: var(--yellow);
}
